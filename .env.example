# ---- Browser (public by design: Firebase web config is not a secret) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- Server only. Locally: put these in .env. Deployed: Vercel env vars. Never prefix with VITE_. ----
# Locally no login is needed; the dev server answers /api/* itself.
DASHBOARD_PASSCODE=     # deployed: a long random secret (12+ chars). Unlock the site with it once per device. Not needed locally.
OWNER_UID=              # deployed only: your Firebase uid; /api/* rejects everyone else
FIREBASE_WEB_API_KEY=   # deployed only: same value as VITE_FIREBASE_API_KEY, used to verify ID tokens
PERPLEXITY_API_KEY=     # optional: live-search news
OPENAI_API_KEY=
VERCEL_TOKEN=           # optional: the Today desk shows your Vercel projects and which are live (create at vercel.com/account/tokens)
VERCEL_TEAM_ID=         # only if your projects belong to a team (starts with team_)
GITHUB_TOKEN=           # optional: lets the Today desk list your open PRs and review requests (read access to pull requests)
TYPESAFE_API_KEY=

OPENAI_MODEL=              # e.g. a small, cheap chat model your account can use
INTERESTS=              # comma list that steers news scoring and ideas, e.g. agents, dev tools, evals
